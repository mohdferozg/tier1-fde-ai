# Copy to .env and fill in your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Optional: primary model. Falls back through 3.8-flash, 3.5-flash, 2.5-flash.
GEMINI_MODEL=gemini-3.8-flash
# Optional: per-request timeout in milliseconds (default 30000).
GEMINI_TIMEOUT_MS=30000
# Optional: hard cap on model round-trips per question (default 6).
AGENT_MAX_TURNS=6
# Optional: override the SQLite file location.
# AGENT_DB_PATH=agent_lab.db
